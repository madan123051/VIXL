{
  "rules": {
    "catalog": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'help@wildsaura.com'"
    },
    "marks": {
      "$workId": {
        "count": {
          ".read": true,
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
        }
      }
    }
  }
}
